# ==============================================================================
# SQLHeal LLM Configuration (.env.example)
# Copy this file to .env and insert your real API key and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Groq (100% Free tier, very fast Llama-3.1-8B and 70B)
# Get a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="your-groq-api-key-here"
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# ------------------------------------------------------------------------------
# Option 2: OpenRouter (Free tier models available, e.g. meta-llama/llama-3.1-8b-instruct:free)
# Get a free key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="your-openrouter-api-key-here"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# ------------------------------------------------------------------------------
# Option 3: Local Ollama (100% Free, offline, no internet/API limits needed)
# Run: ollama run llama3.1:8b
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"

# Active Environment Variables
OPENAI_API_KEY=
OPENAI_BASE_URL=
