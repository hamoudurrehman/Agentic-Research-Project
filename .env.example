# ==============================================================================
# SQLHeal LLM Configuration (.env.example)
# Copy this file to .env and insert your real API key and settings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Groq (Recommended - 100% Free tier, ultra-fast Llama-3.1-8B)
# Get a free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY="gsk_your_groq_api_key_here"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# ------------------------------------------------------------------------------
# Option 2: OpenRouter (Access to Gemini 2.5 / 1.5, DeepSeek, Llama 3.1)
# Get an API key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="sk-or-v1-your_openrouter_api_key_here"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# ------------------------------------------------------------------------------
# Option 3: Local Ollama (100% Free, offline, no API limits)
# Ensure Ollama is running: ollama run llama3.1:8b
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"

# ------------------------------------------------------------------------------
# Option 4: Official OpenAI (GPT-4o, GPT-4o-mini)
# Get an API key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="sk-your_openai_api_key_here"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# Offline Simulation Mode (For CI/CD and dry tests without real LLM/API keys)
# Set to 1 to simulate responses deterministically without any network or keys
# ------------------------------------------------------------------------------
# SQLHEAL_MOCK=0
